# ===== Database =====
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/openclaw_platform
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/openclaw_platform

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Telegram Bot =====
BOT_TOKEN=
ADMIN_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# ===== API =====
API_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1

# ===== YooKassa =====
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# ===== Encryption =====
ENCRYPTION_KEY=

# ===== App =====
DEBUG=true
APP_NAME=OpenClaw Platform
